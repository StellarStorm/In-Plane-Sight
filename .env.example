# 'internet' uses adsb.lol, with adsb.fi as a free fallback
# 'local'    uses a running dump1090-fa or readsb instance (RTL-SDR) - not yet developed!
SOURCE=internet

LAT=39.9526
LON=-75.1652
RADIUS_NM=50
TIME_FORMAT=24
REFRESH_SECONDS=15
FONT_THICKNESS=normal  # or broad
FLICKER_ENABLED=true
FLICKER_STRENGTH=0.025

# Only needed when SOURCE=local - not yet developed!
LOCAL_URL=http://localhost:8080/data/aircraft.json

# Optional FAA SWIFT/SCDS Flight FIXM route feed. Leave disabled for default behavior.
SWIFT_ENABLED=false
SWIFT_HOST=tcps://ems1.swim.faa.gov:55443
SWIFT_QUEUE=
SWIFT_VPN=FDPS
SWIFT_USERNAME=
SWIFT_PASSWORD=
# Hashed CA directory including DigiCert Global Root G2 for TLS validation.
# Required when SWIFT_ENABLED=true; keep certificate validation enabled.
SWIFT_CA_DIR=

HOST=0.0.0.0
PORT=8000
