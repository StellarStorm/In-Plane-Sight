# 'internet' uses adsb.lol (free, no key needed)
# 'local'    uses a running dump1090-fa or readsb instance (RTL-SDR)
SOURCE=internet

LAT=39.9526
LON=-75.1652
RADIUS_NM=50
REFRESH_SECONDS=15

# Only needed when SOURCE=local
LOCAL_URL=http://localhost:8080/data/aircraft.json

HOST=0.0.0.0
PORT=8000
